+function queryExplicitlyRequestsAppointments(query = "", body = {}) {
+  if (body.shouldShowAppointments === true) return true;
+
+  const text = normalize(query);
+
+  const explicitAppointmentSignals = [
+    "appointment",
+    "appointments",
+    "available",
+    "availability",
+    "opening",
+    "openings",
+    "book",
+    "booking",
+    "schedule",
+    "next available",
+    "soonest",
+    "asap",
+    "right now",
+    "near me",
+    "today",
+    "tomorrow",
+    "tonight",
+    "this weekend",
+    "what times",
+    "when is",
+    "when can i"
+  ];
+
+  if (explicitAppointmentSignals.some((signal) => text.includes(signal))) {
+    return true;
+  }
+
+  const serviceWords = [
+    "massage",
+    "deep tissue",
+    "swedish",
+    "sports massage",
+    "thai",
+    "ashiatsu",
+    "prenatal",
+    "trigger point",
+    "lomi"
+  ];
+
+  const shoppingWords = [
+    "i need",
+    "i want",
+    "looking for",
+    "find me",
+    "show me",
+    "get me",
+    "need a",
+    "want a"
+  ];
+
+  return (
+    serviceWords.some((word) => text.includes(word)) &&
+    shoppingWords.some((word) => text.includes(word))
+  );
+}
+
+function queryLooksInfoOnly(query = "", body = {}) {
+  if (body.shouldShowAppointments === false) return true;
+
+  const text = normalize(query);
+
+  const infoSignals = [
+    "tell me about",
+    "what is",
+    "what are",
+    "explain",
+    "describe",
+    "difference between",
+    "compare",
+    "which is better",
+    "how does",
+    "why does",
+    "reviews",
+    "review",
+    "about this business",
+    "about the business"
+  ];
+
+  return infoSignals.some((signal) => text.includes(signal));
+}
+
+function classifyAiPrompt(query = "", conversationState = {}, body = {}) {
+  if (queryExplicitlyRequestsAppointments(query, body)) {
+    return "appointment_search";
+  }
+
+  const text = normalize(query);
+  const businessInfoSignals = [
+    "tell me about",
+    "describe",
+    "reviews",
+    "review",
+    "about this business",
+    "about the business"
+  ];
+
+  if (
+    queryLooksInfoOnly(query, body) &&
+    businessInfoSignals.some((signal) => text.includes(signal))
+  ) {
+    return "business_info";
+  }
+
+  if (queryLooksInfoOnly(query, body)) {
+    return "general_info";
+  }
+
+  return "appointment_search";
+}
+
+function getBusinessSearchText(business = {}) {
+  return normalize(
+    [
+      business.businessName,
+      business.name,
+      business.businessType,
+      business.address,
+      business.positioning?.shortDescription,
+      ...(business.positioning?.bestFor || []),
+      ...(business.positioning?.styleTags || []),
+      ...(business.specialties || []),
+      ...(business.amenities || []),
+      ...(business.clientTypes || [])
+    ]
+      .filter(Boolean)
+      .join(" ")
+  );
+}
+
+function findBusinessInfoMatch(query = "", businessKnowledge = []) {
+  const text = normalize(query);
+
+  if (!Array.isArray(businessKnowledge)) return null;
+
+  const sortedBusinesses = [...businessKnowledge].sort((a, b) => {
+    const aName = String(a.businessName || a.name || "");
+    const bName = String(b.businessName || b.name || "");
+    return bName.length - aName.length;
+  });
+
+  for (const business of sortedBusinesses) {
+    const name = normalize(business.businessName || business.name || "");
+
+    if (name && text.includes(name)) {
+      return business;
+    }
+
+    const compactName = name.replace(/\s+/g, "");
+    const compactText = text.replace(/\s+/g, "");
+
+    if (compactName && compactText.includes(compactName)) {
+      return business;
+    }
+  }
+
+  const meaningfulWords = text
+    .replace(/\b(tell|me|about|the|business|reviews|review|describe|what|is)\b/g, " ")
+    .split(" ")
+    .map((word) => word.trim())
+    .filter((word) => word.length > 3);
+
+  if (!meaningfulWords.length) return null;
+
+  return (
+    sortedBusinesses.find((business) => {
+      const haystack = getBusinessSearchText(business);
+      return meaningfulWords.every((word) => haystack.includes(word));
+    }) || null
+  );
+}
+
+function formatList(values = [], maxItems = 4) {
+  if (!Array.isArray(values)) return "";
+
+  return values
+    .filter(Boolean)
+    .slice(0, maxItems)
+    .join(", ");
+}
+
+function buildBusinessInfoAnswer(query = "", businessKnowledge = [], relevantBusinesses = []) {
+  const business =
+    findBusinessInfoMatch(query, businessKnowledge) ||
+    (Array.isArray(relevantBusinesses) && relevantBusinesses.length === 1
+      ? relevantBusinesses[0]
+      : null);
+
+  if (!business) {
+    return "I can help with business details, but I do not have enough profile information loaded for that specific business yet. Try asking for live appointments, or include the exact business name.";
+  }
+
+  const businessName = business.businessName || business.name || "This business";
+  const shortDescription =
+    business.positioning?.shortDescription ||
+    business.shortDescription ||
+    business.description ||
+    "";
+
+  const bestFor = formatList(business.positioning?.bestFor || business.bestFor || []);
+  const specialties = formatList(business.specialties || []);
+  const amenities = formatList(business.amenities || []);
+  const address = business.address || "";
+
+  const parts = [];
+
+  if (shortDescription) {
+    parts.push(`${businessName} is ${shortDescription}`);
+  } else {
+    parts.push(`${businessName} is a massage/wellness business listed on NextAppt.`);
+  }
+
+  if (specialties) {
+    parts.push(`Known services or specialties include ${specialties}.`);
+  }
+
+  if (bestFor) {
+    parts.push(`It may be a good fit for ${bestFor}.`);
+  }
+
+  if (amenities) {
+    parts.push(`Amenities or related offerings include ${amenities}.`);
+  }
+
+  if (address) {
+    parts.push(`Address: ${address}.`);
+  }
+
+  parts.push("Ask for live appointment times if you want current availability for this business.");
+
+  return parts.join(" ");
+}
+
+function loadServiceTaxonomy() {
+  const candidates = [
+    "ai-data/ai-service-taxonomy.json",
+    "ai-service-taxonomy.json",
+    "data/ai-service-taxonomy.json"
+  ];
+
+  for (const relativePath of candidates) {
+    const value = readJson(relativePath, null);
+
+    if (value && typeof value === "object") {
+      return value;
+    }
+  }
+
+  return {};
+}
+
+function findServiceTaxonomyMatch(query = "", taxonomy = {}) {
+  const text = normalize(query);
+
+  for (const [serviceKey, service] of Object.entries(taxonomy || {})) {
+    const name = normalize(service.displayName || serviceKey);
+    const aliases = Array.isArray(service.aliases) ? service.aliases : [];
+
+    if (name && text.includes(name)) {
+      return { serviceKey, ...service };
+    }
+
+    if (text.includes(normalize(serviceKey))) {
+      return { serviceKey, ...service };
+    }
+
+    for (const alias of aliases) {
+      if (alias && text.includes(normalize(alias))) {
+        return { serviceKey, ...service };
+      }
+    }
+  }
+
+  return null;
+}
+
+function buildGeneralInfoAnswer(query = "", matchedIntent = null) {
+  const taxonomy = loadServiceTaxonomy();
+  const matchedService = findServiceTaxonomyMatch(query, taxonomy);
+
+  if (matchedService) {
+    const displayName = matchedService.displayName || "This service";
+    const description = matchedService.description || "";
+    const recommendedFor = formatList(matchedService.recommendedFor || [], 5);
+    const commonGoals = formatList(matchedService.commonGoals || [], 5);
+
+    const parts = [];
+
+    if (description) {
+      parts.push(`${displayName}: ${description}`);
+    } else {
+      parts.push(`${displayName} is one of the massage services NextAppt can help you understand or search for.`);
+    }
+
+    if (recommendedFor) {
+      parts.push(`Commonly recommended for: ${recommendedFor}.`);
+    }
+
+    if (commonGoals) {
+      parts.push(`Common goals include ${commonGoals}.`);
+    }
+
+    parts.push("If you want, ask for live appointment times and I can search current availability.");
+
+    return parts.join(" ");
+  }
+
+  if (matchedIntent?.answer) {
+    return String(matchedIntent.answer);
+  }
+
+  if (matchedIntent?.summary) {
+    return String(matchedIntent.summary);
+  }
+
+  if (matchedIntent?.intentKey || matchedIntent?.displayName) {
+    const label = matchedIntent.displayName || matchedIntent.intentKey;
+    const services = formatList(matchedIntent.recommendedServices || [], 4);
+
+    if (services) {
+      return `${label}: people often look for ${services} for this kind of need. If you want live availability, ask for appointment times and I can search current openings.`;
+    }
+  }
+
+  return "I can help explain massage services, business details, and live appointment availability. For this question, I do not have enough knowledge loaded yet to give a detailed answer.";
+}
